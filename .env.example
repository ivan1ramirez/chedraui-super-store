# Copia este archivo a .env y ajusta los valores
FLASK_DEBUG=1
PORT=5000
PUBLIC_URL=http://localhost:5000

# Token para POST /api/sync-chedraui (header X-Admin-Token). Genera uno largo y aleatorio.
ADMIN_TOKEN=cambia-esto-por-un-token-largo

# Stripe (modo prueba). Déjalo vacío para usar la pasarela simulada.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

# Negocio
IVA_RATE=0.16
MARKUP_PCT=0          # % de margen sobre el precio de Chedraui

# Scraper
SCRAPER_SLEEP=1.5
SCRAPER_TIMEOUT=20
